# Copy to .env and adjust. All values here are placeholders.

# SQLite database file used by the server and the seed script.
NOECHO_DB_PATH=./noecho.db

# Uniqueness gate: a submission whose best similarity score against an
# existing comment in the same thread is >= this value is blocked.
NOECHO_GATE_THRESHOLD=0.45

# Distinct source domains required before a factual claim reads as
# verified or refuted.
NOECHO_MIN_SOURCES=1

# Optional LLM features. "none" disables them; the core works without a key.
NOECHO_LLM_PROVIDER=none
NOECHO_LLM_API_KEY=replace-me
